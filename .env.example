# FL-008: credential fields are classified; see docs/SECRETS.md.
# These placeholders are only for local/test. Enabled staging/production clients reject them.
# Optional local overrides. Copy to .env at repository root.
# API persistence is opt-in; it reuses the PostgreSQL variables below.
FLEETLINK_ENVIRONMENT=local
FLEETLINK_LOG_LEVEL=INFO

# Shared local Docker/API PostgreSQL configuration. Never reuse these placeholders in production.
FLEETLINK_POSTGRES_DB=fleetlink_dev
FLEETLINK_POSTGRES_USER=fleetlink_dev
FLEETLINK_POSTGRES_PASSWORD=development-only-postgres
FLEETLINK_POSTGRES_PORT=5432
FLEETLINK_REDIS_PORT=6379
FLEETLINK_RABBITMQ_USER=fleetlink_dev
FLEETLINK_RABBITMQ_PASSWORD=development-only-rabbitmq
FLEETLINK_RABBITMQ_AMQP_PORT=5672
FLEETLINK_RABBITMQ_MANAGEMENT_PORT=15672

# FL-005 optional API persistence. Explicitly load this file; no dotenv discovery.
FLEETLINK_DATABASE_ENABLED=false
FLEETLINK_POSTGRES_HOST=127.0.0.1
FLEETLINK_DATABASE_POOL_SIZE=5
FLEETLINK_DATABASE_MAX_OVERFLOW=5
FLEETLINK_DATABASE_POOL_TIMEOUT=5
FLEETLINK_DATABASE_CONNECT_TIMEOUT=5
FLEETLINK_DATABASE_COMMAND_TIMEOUT=30

# FL-006 optional Redis and separately invoked Celery processes.
FLEETLINK_REDIS_ENABLED=false
FLEETLINK_REDIS_HOST=127.0.0.1
# Local Redis has no ACL password; set only for a configured server.
# FLEETLINK_REDIS_USERNAME=
# FLEETLINK_REDIS_PASSWORD=
FLEETLINK_REDIS_MAX_CONNECTIONS=5
FLEETLINK_REDIS_CONNECT_TIMEOUT=2
FLEETLINK_REDIS_OPERATION_TIMEOUT=2
FLEETLINK_CELERY_ENABLED=false
FLEETLINK_RABBITMQ_HOST=127.0.0.1
FLEETLINK_RABBITMQ_VHOST=/
FLEETLINK_BROKER_CONNECT_TIMEOUT=2
FLEETLINK_BROKER_OPERATION_TIMEOUT=2
FLEETLINK_CELERY_QUEUE=fleetlink.technical.v1
FLEETLINK_CELERY_CONCURRENCY=1

# FL-007 export is opt-in and never a readiness dependency. Explicitly load this file.
FLEETLINK_TELEMETRY_ENABLED=false
# Required only when enabled; HTTP(S) origin, no credentials/query/path.
# FLEETLINK_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
FLEETLINK_OTEL_EXPORT_TIMEOUT_SECONDS=2
FLEETLINK_OTEL_SAMPLE_RATIO=1
