# Optional local overrides. Copy to .env at repository root.
# The API itself requires no infrastructure credentials or connection strings.
FLEETLINK_ENVIRONMENT=local
FLEETLINK_LOG_LEVEL=INFO

# FL-003 local Docker infrastructure only. Never reuse these placeholders in production.
FLEETLINK_POSTGRES_DB=fleetlink_dev
FLEETLINK_POSTGRES_USER=fleetlink_dev
FLEETLINK_POSTGRES_PASSWORD=development-only-postgres
FLEETLINK_POSTGRES_PORT=5432
FLEETLINK_REDIS_PORT=6379
FLEETLINK_RABBITMQ_USER=fleetlink_dev
FLEETLINK_RABBITMQ_PASSWORD=development-only-rabbitmq
FLEETLINK_RABBITMQ_AMQP_PORT=5672
FLEETLINK_RABBITMQ_MANAGEMENT_PORT=15672
